# Copy to .env (git-ignored) and adjust to your machine.
# Root of the llvm-mingw toolchain (https://github.com/mstorsjo/llvm-mingw/releases)
LLVM_MINGW_DIR=/home/<user>/tools/llvm-mingw-20250402-ucrt-ubuntu-20.04-x86_64
# Folder the exe is copied to after each build (leave empty to skip)
DEPLOY_DIR=/mnt/c/Users/<user>/Desktop/Poe2MapStat
# GitHub repository for self-update, e.g. owner/poe2-mapstat (only baked into Release builds; empty = no updater)
GITHUB_REPO=
